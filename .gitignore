# Large binary evidence stays local; custody index (sha256 + URLs) is committed
research/**/evidence/**/*.pdf

# media binaries stay local; transcripts + custody index are committed
research/**/evidence/video/*.mp3
research/**/evidence/video/*.m4a
research/**/evidence/video/*.mp4

# never commit secrets
*.env
hugging.txt

# large media stays local
research/**/evidence/recordings/*.m4a
research/**/evidence/recordings/*.mp3
research/**/evidence/recordings/*.jpg
.venv-audio/
